# 复制成 .env 或导出为环境变量后按需修改；未设置的项使用 application.yml 里的默认值。

# ---------- 本站 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL（docker-compose.yml 默认账号） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jistack_platform
MYSQL_USERNAME=root
MYSQL_PASSWORD=jistack

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 密钥 ----------
# 加密 component_secret / encoding_aes_key / authorizer_refresh_token 的主密钥。
# 生成：openssl rand -base64 32
# 注意：一旦有数据就不能更换，否则已存凭据无法解密。
PLATFORM_MASTER_KEY=
# 管理端登录令牌签名密钥。生成：openssl rand -hex 32
PLATFORM_JWT_SECRET=

# ---------- 微信 ----------
# 微信接口基地址；「平台配置」页的「微信接口域名」非空时优先用那个值。改成桩服务地址可用于本地联调。
WECHAT_API_BASE=https://api.weixin.qq.com
# 生成扫码授权链接时使用的本站回调基地址，必须是外网可访问的 https 域名
PLATFORM_SITE_BASE=https://platform.example.com
