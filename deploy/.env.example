# 生产环境变量模板。复制为 .env 后填值：cp .env.example .env
# 真凭据只写在 .env（已被 .gitignore 排除），这个模板里的密钥位一律留空。

# 第三方平台后台要填的两个地址都由这个域名拼出来（后台「平台配置」页有现成的可复制）：
#   授权事件接收 URL   https://<域名>/wx/callback
#   消息与事件接收 URL https://<域名>/wx/callback/$APPID$   ← 结尾的 $APPID$ 原样保留，微信会替换成实际 appid
# 前提：域名已备案、已解析到本机 80/443，否则微信侧校验不过。
PLATFORM_DOMAIN=platform.example.com

MYSQL_DATABASE=jistack_platform
MYSQL_USERNAME=platform
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

# 加密 component_secret / encoding_aes_key / authorizer_refresh_token 的主密钥。
# 生成：openssl rand -base64 32
# 换了它，库里已加密的凭据都解不开，需要在「平台配置」页重新填一次微信凭据。
# 第一次启动之前就要定下来并备份：留空会退化成每次启动随机的临时密钥。
PLATFORM_MASTER_KEY=

# 后台登录令牌(HMAC)的签名密钥，随便长字符串，别复用别的系统的。
# 留空则每次启动随机，重启即所有登录态失效。
PLATFORM_JWT_SECRET=

# component_appid / component_secret / 消息校验 Token / 43 位 AESKey
# 不在这里配，上线后进后台「平台配置」页填，保存后立刻能用健康检查验证回调链路。

# 微信接口基地址，留空即直连 https://api.weixin.qq.com。
# 只有在出口要走自建代理时才设；后台「平台配置」的「微信接口域名」非空时优先用它。
#WECHAT_API_BASE=https://api.weixin.qq.com

# ---- 手机号验证码登录：阿里云短信 ----
# false 时验证码照常生成、照常只认一次，只是把明文码打进 api 容器日志（开发用，没人收得到短信）。
# 正式环境必须 true；开了却没配齐下面四项，「获取验证码」会直接报「缺少配置」，不会静默失败。
PLATFORM_SMS_ENABLED=

# RAM 子账号的 AccessKey，只挂 AliyunDysmsFullAccess 这一个策略，别用主账号的。
# 只活在这个文件和容器环境里：不进 git、不落库、后台页面上也看不到。
PLATFORM_SMS_ACCESS_KEY_ID=
PLATFORM_SMS_ACCESS_KEY_SECRET=

# 控制台「短信签名」和「模板管理」里审核通过后的签名名称与模板 Code，逐字一致（大小写、空格都算）。
# 模板正文形如「您的验证码为${code}，5 分钟内有效」，变量名要和下面的 TEMPLATE_PARAM_KEY 对上。
PLATFORM_SMS_SIGN_NAME=
PLATFORM_SMS_TEMPLATE_CODE=

# 下面三项留空即用默认值（官方接入地址 / cn-hangzhou / 变量名 code），一般不用动。
# ENDPOINT 只在出口要走自建代理时才改；TEMPLATE_PARAM_KEY 只在模板变量名不叫 code 时才改。
#PLATFORM_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
#PLATFORM_SMS_REGION=cn-hangzhou
#PLATFORM_SMS_TEMPLATE_PARAM_KEY=code

# 有效期 5 分钟、同号码同用途 60 秒冷却、每号每天 10 条、同源 IP 每小时 20 次
# 这些阈值在 application.yml 的 platform.sms.code.* 里，要临时改就在 .env 加同名变量覆盖，
# 例如 PLATFORM_SMS_CODE_DAILY_LIMIT_PER_PHONE=5（Spring 会把下划线松绑定到嵌套属性）。
